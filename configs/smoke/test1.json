{
  "experiment": "test-something",
  "mlflow_tags": { "project": "cpu-isolation" },
  "defaults": {
    "server_numa": 1,
    "client_numa": 0,
    "max_seconds": 10,
    "vllm_extra_args": "--dtype=bfloat16 --max-num-batched-tokens 2048",
     "container_env": {
      "VLLM_CPU_OMP_THREADS_BIND": "auto",
      "VLLM_CPU_NUM_OF_RESERVED_CPU": "1",
      "CPU_VISIBLE_MEMORY_NODES": "1",
      "HF_HUB_OFFLINE": "1"
    }
  },
  "runs": [
    {
      "run_name": "llame-qwen-kv64-c32-isl128-osl128-mnbs2048",
      "model": "meta-llama/Llama-3.1-8B-Instruct",
      "kv_cache_gb": 64,
      "isl": 128,
      "osl": 128,
      "rate": "1,2",
      "vllm_extra_args": "--dtype=bfloat16 --max-model-len 4096 --max-num-batched-tokens 2048",
      "mlflow_tags": { "project": "kvcache-study","variant": "kv64" }
    },
    {
      "run_name": "llam-qwen-kv128-c8-run2",
      "model": "meta-llama/Llama-3.1-8B-Instruct",
      "kv_cache_gb": 128,
      "isl": 128,
      "osl": 128,
      "rate": "1,2",
      "vllm_extra_args": "--dtype=bfloat16 --max-model-len 4096 --max-num-batched-tokens 2048",
      "mlflow_tags": { "project": "kvcache-study","variant": "kv128" }
    }
  ]
}
