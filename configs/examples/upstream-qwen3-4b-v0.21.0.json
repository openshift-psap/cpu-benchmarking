{
  "experiment": "vllm-cpu-benchmarking-3.4-SPR-upstream",
  "defaults": {
    "server_numa": 1,
    "client_numa": 0,
    "max_seconds": 300,
    "isl": 128,
    "osl": 128,
    "rate": "1,2,4,8,16,32",
    "kv_cache_gb": 64,
    "vllm_extra_args": "--dtype=bfloat16",
    "model": "Qwen/Qwen3-4B",
    "vllm_image": "vllm/vllm-openai-cpu:v0.21.0",
    "dashboard_version": "upstream-v0.21.0",
    "hf_home": "/home/naveen/models:/models",
    "guidellm_venv": "/home/naveen/guidellm_env/",
    "vllm_omp_threads_bind": "auto",
    "mlflow_tags": {
        "kv_cache_gb": "64",
        "model": "Qwen3-4B",
        "vllm_version": "v0.21.0"
    },
    "environment": {
      "HF_HUB_OFFLINE": "1",
      "CPU_VISIBLE_MEMORY_NODES": "1",
      "HF_TOKEN":""
    }
  },
