{
  "experiment": "isl-sweep-single-cpu-osl1",
  "description": "Single pinned CPU (taskset + omp) sweep of input sequence length (ISL) with OSL=1. Edit hf_home, model, and max_seconds for your host. vllm_extra_args uses max-model-len 8192 so the largest ISL fits; reduce kv_cache_gb if memory is tight.",
  "defaults": {
    "server_numa": 0,
    "client_numa": 0,
    "server_cpulist": "0",
    "omp_num_threads": 1,
    "max_seconds": 120,
    "rate": "1",
    "osl": 1,
    "kv_cache_gb": 8,
    "port": 8000,
    "shm_size": "4g",
    "vllm_image": "docker.io/vllm/vllm-openai-cpu:v0.18.0",
    "vllm_extra_args": "--dtype=bfloat16 --max-model-len 8192 --max-num-batched-tokens 8192",
    "hf_home": "/path/on/host/models:/models",
    "hf_home_container": "/models",
    "output_dir": "./results/isl_sweep_single_cpu",
    "environment": {
      "OMP_NUM_THREADS": "1",
      "VLLM_CPU_OMP_THREADS_BIND": "0",
      "HF_HUB_OFFLINE": "1"
    }
  },
  "runs": [
    {
      "run_name": "qwen06b-isl16-osl1-cpu0",
      "model": "Qwen/Qwen3-0.6B",
      "isl": 16,
      "osl": 1,
      "mlflow_tags": {
        "suite": "isl-sweep",
        "isl": "16"
      }
    },
    {
      "run_name": "qwen06b-isl24-osl1-cpu0",
      "model": "Qwen/Qwen3-0.6B",
