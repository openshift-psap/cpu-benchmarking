{
  "experiment": "vllm-cpu-study-gemma",
  "mlflow_tags": { "project": "cpu-isolation" },
  "defaults": {
    "server_numa": 1,
    "client_numa": 0,
    "max_seconds": 450,
    "vllm_extra_args": "--dtype=bfloat16 --max-num-batched-tokens 4096",
    "container_env": {
      "VLLM_CPU_OMP_THREADS_BIND": "auto",
