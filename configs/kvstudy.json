{
  "experiment": "vllm-cpu-study-ibm-granite",
  "mlflow_tags": { "project": "cpu-isolation" },
  "defaults": {
    "server_numa": 1,
    "client_numa": 0,
    "max_seconds": 420,
    "vllm_extra_args": "--dtype=bfloat16 --max-num-batched-tokens 2048",
      "container_env": {
         "VLLM_CPU_OMP_THREADS_BIND": "auto",
         "VLLM_CPU_NUM_OF_RESERVED_CPU": "1",
         "CPU_VISIBLE_MEMORY_NODES": "1",
         "HF_HUB_OFFLINE": "1"
      }
  },
  "runs": [
    {
      "run_name": "qwen-kv64-c32-isl128-osl128-mnbs2048",
      "model": "ibm-granite/granite-3.2-2b-instruct",
      "kv_cache_gb": 64,
      "isl": 128,
      "osl": 128,
      "rate": "1,2,4,8,16,32,64,128,256",
      "vllm_extra_args": "--dtype=bfloat16 --max-model-len 4096 --max-num-batched-tokens 2048",
      "mlflow_tags": { "project": "kvcache-study-mnbs2048","variant": "kv64" }
    },
    {
      "run_name": "qwen-kv128-c32-isl128-osl128-mnbs2048",
      "model": "ibm-granite/granite-3.2-2b-instruct",
      "kv_cache_gb": 128,
      "isl": 128,
      "osl": 128,
      "rate": "1,2,4,8,16,32,64,128,256",
      "vllm_extra_args": "--dtype=bfloat16 --max-model-len 4096 --max-num-batched-tokens 2048",
      "mlflow_tags": { "project": "kvcache-study-mnbs2048","variant": "kv128" }
    },
    {
      "run_name": "qwen-kv180-c32-isl128-osl128-mnbs2048",
      "model": "ibm-granite/granite-3.2-2b-instruct",
      "kv_cache_gb": 180,
      "isl": 128,
      "osl": 128,
      "rate": "1,2,4,8,16,32,64,128,256",
      "vllm_extra_args": "--dtype=bfloat16 --max-model-len 4096 --max-num-batched-tokens 2048",
      "mlflow_tags": { "project": "kvcache-study-mnbs2048","variant": "kv180" }
    },
    {
      "run_name": "qwen-kv216-c32-isl128-osl128-mnbs2048",
      "model": "ibm-granite/granite-3.2-2b-instruct",
      "kv_cache_gb": 216,
      "isl": 128,
      "osl": 128,
      "rate": "1,2,4,8,16,32,64,128,256",
      "vllm_extra_args": "--dtype=bfloat16 --max-model-len 4096 --max-num-batched-tokens 2048",
      "mlflow_tags": { "project": "kvcache-study-mnbs2048","variant": "kv216" }
    },
    {
      "run_name": "qwen-kv64-c32-isl128-osl512-mnbs2048",
      "model": "ibm-granite/granite-3.2-2b-instruct",
      "kv_cache_gb": 64,
      "isl": 128,
      "osl": 512,
      "rate": "1,2,4,8,16,32,64,128,256",
      "vllm_extra_args": "--dtype=bfloat16 --max-model-len 4096 --max-num-batched-tokens 2048",
      "mlflow_tags": { "project": "kvcache-study-mnbs2048","variant": "kv64" }
    }
  ]
}
